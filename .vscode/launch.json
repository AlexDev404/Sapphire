{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SapphireOS: Debug kernel",
      "type": "gdb",
      "request": "attach",
      "executable": "${workspaceFolder}\\src\\kernel.bin.sym",
      "target": "localhost:1234",
      "remote": true,
      "cwd": "${workspaceFolder}\\src",
      "gdbpath": "C:\\mingw64\\bin\\gdb.exe",
      "debugger_args": [
        "-ex", "set architecture i386",
        "-ex", "set osabi none"
      ],
      "autorun": [
        "b _entry",
        "b bootstrap_paging",
        "b platform_init"
      ],
      "valuesFormatting": "prettyPrinters"
    }
  ]
}
